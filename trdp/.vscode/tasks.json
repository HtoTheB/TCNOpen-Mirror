{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Make Linux Config",
            "type": "shell",
            "command": "make",
            "args": [
                "--directory=${workspaceFolder}",
                "LINUX_config"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Make Linux HP10 Config (fast, base 10)",
            "type": "shell",
            "command": "make",
            "args": [
                "--directory=${workspaceFolder}",
                "LINUX_HP10_config"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Make Linux HP2 Config (fast, base 2)",
            "type": "shell",
            "command": "make",
            "args": [
                "--directory=${workspaceFolder}",
                "LINUX_HP2_config"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Make Linux-TSN Config",
            "type": "shell",
            "command": "make",
            "args": [
                "--directory=${workspaceFolder}",
                "LINUX_TSN_config"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Make Debug",
            "type": "shell",
            "command": "make",
            "args": [
                "all",
                "--directory=${workspaceFolder}",
                "DEBUG=TRUE"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Make Exec",
            "type": "shell",
            "command": "make",
            "args": [
                "all",
                "--directory=${workspaceFolder}"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Make Clean",
            "type": "shell",
            "command": "make",
            "args": [
                "clean",
                "--directory=${workspaceFolder}",
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Windows TRDP (Debug x64)",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}/VSExpress2019/Win_TRDP_VS2019.sln",
                "/p:Configuration=Debug",
                "/p:Platform=x64"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}